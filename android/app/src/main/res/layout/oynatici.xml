<?xml version="1.0" encoding="utf-8"?>
<!-- 3.80: perde saydam — kare çizilene kadar altta duran akıcı önizlemenin donmuş karesi görünür (siyah ekran yok).
     Önizleme oynatıcısı. TextureView: geçiş ve yakınlaşma efektleri önizlemede de ölçeklenebilsin diye (SurfaceView ölçeklenmez). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="#00000000"
    app:keep_content_on_player_reset="true" />
